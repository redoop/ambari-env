@@ -0,0 +1,41 @@
+250211 推荐部署方式
+
+ozone manager 3台
+ozone datanode 3台
+ozone scm 3台
+ozone s3g 1台
+ozone recon server 1台
+
+
+
+第一台机器执行
+./ozone scm --init
+./ozone --daemon start scm
+
+其余机器执行
+./ozone scm --bootstrap
+./ozone --daemon start scm
+
+
+每个机器都执行
+./ozone om --init
+
+./ozone --daemon start om
