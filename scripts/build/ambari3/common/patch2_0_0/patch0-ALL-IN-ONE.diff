+            ofp = open(upgrade_marker_file, 'w')
+            ofp.write(msg)
+            ofp.close()
+        except OSError as exc:
+            if exc.errno == errno.EEXIST and os.path.isdir(config_dir):
+                pass
+            else:
+                raise
+
+    def is_ru_rangeradmin_in_progress(self, upgrade_marker_file):
