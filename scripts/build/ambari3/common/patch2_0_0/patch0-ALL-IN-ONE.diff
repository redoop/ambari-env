+            # Set the proxy user for Atlas
+            knox_service_user = services['configurations']['knox-env']['properties']['knox_user'] \
+                if 'knox-env' in services['configurations'] and 'knox_user' in \
+                   services['configurations']['knox-env']['properties'] \
