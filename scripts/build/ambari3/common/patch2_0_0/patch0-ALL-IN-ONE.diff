+  <property>
+    <name>ozone_principal_name</name>
+	<display-name>ozone principal name</display-name>
+    <description>OZONE principal name</description>
+    <property-type>KERBEROS_PRINCIPAL</property-type>
+    <on-ambari-upgrade add="false"/>
