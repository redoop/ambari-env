+    def get_system_min_uid(self):
+        login_defs = '/etc/login.defs'
+        uid_min_tag = 'UID_MIN'
+        comment_tag = '#'
+        uid_default = '1000'
+        uid_min = uid_default
+
+        if os.path.exists(login_defs):
+            with open(login_defs, 'r') as f:
+                lines = f.readlines()
+                # 过滤出非注释的 UID_MIN 行
+                candidates = [
+                    line for line in lines
+                    if uid_min_tag in line and (
+                            line.find(comment_tag) == -1 or line.find(comment_tag) > line.find(uid_min_tag))
+                ]
+                if candidates:
+                    line = candidates[0]
+                    comment = line.find(comment_tag)
+                    tag = line.find(uid_min_tag)
+                    if comment == -1:
+                        uid_tag = tag + len(uid_min_tag)
+                        uid_min = line[uid_tag:].strip()
+                    elif comment > tag:
+                        uid_tag = tag + len(uid_min_tag)
+                        uid_min = line[uid_tag:comment].strip()
+
+        # 检查结果
+        try:
+            int(uid_min)
+        except ValueError:
+            return uid_default
+
+        return uid_min
