+    """
+    根据堆大小和比例，计算Xmn参数，自动适配xmn_max是int还是字符串（带单位）。
+    :param heapsize_str: str, 例如'1000m', '4096m'
+    :param xmn_percent: float, 例如0.2
+    :param xmn_max: int或str, 例如512, '512m'
+    :return: 结果字符串，如'200m'
+    """
+    # 处理xmn_max为字符串时的情况，只取数字部分
+    if isinstance(xmn_max, str):
+        m = re.match(r'^(\d+)', xmn_max.strip().lower())
+        if m:
+            xmn_max = int(m.group(1))
+        else:
+            raise ValueError(f"xmn_max格式错误: {xmn_max}")
+
+    m = re.match(r'^(\d+)([a-zA-Z]+)?$', heapsize_str.strip())
+    if not m:
+        raise ValueError(f'heapsize_str格式不对，必须是数字加单位: {heapsize_str}')
+    heapsize = int(m.group(1))
+    heapsize_unit = m.group(2) if m.group(2) else 'm'
+    xmn_val = int(math.floor(heapsize * xmn_percent))
+    xmn_val -= xmn_val % 8
+    result_xmn_val = xmn_max if xmn_val > xmn_max else xmn_val
