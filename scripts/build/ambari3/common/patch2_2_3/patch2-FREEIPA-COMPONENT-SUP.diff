@@ -195,6 +195,25 @@
     if 'ranger.ha.spnego.kerberos.keytab' in ranger_admin_site_copy:
         ranger_admin_site_copy['ranger.spnego.kerberos.keytab'] = ranger_admin_site_copy[
             'ranger.ha.spnego.kerberos.keytab']
+        ranger_admin_site_copy['ranger.ha.spnego.kerberos.principal'] = params.ranger_spnego_kerberos_principal
+
+    # 【TTBigdata 定制@since 2.2.3】
+    # Ranger Admin 选择 LDAP 模式时：
+    # - 强制移除 ranger.ldap.ad.* 相关参数，避免被错误分支/兼容逻辑干扰
+    # - 同时清掉 dnpattern，强制走 search（避免 dnpattern 绑死 DN 造成认证失败或重复匹配）
+    for k in list(ranger_admin_site_copy.keys()):
+      if k.startswith('ranger.ldap.ad.'):
+        ranger_admin_site_copy.pop(k, None)
+
+    # 【TTBigdata 定制@since 2.2.3】清掉 dnpattern，强制走 search
+    ranger_admin_site_copy.pop('ranger.ldap.user.dnpattern', None)
+
+    # 如果返回false 则执行
+    if not params.is_ranger_ha_enabled:
+      ranger_admin_site_copy.pop('ranger.ha.spnego.kerberos.principal',None)
+      ranger_admin_site_copy.pop('ranger.ha.spnego.kerberos.keytab',None)
+      ranger_admin_site_copy['ranger.spnego.kerberos.principal']=params.ranger_spnego_kerberos_principal
+      ranger_admin_site_copy['ranger.spnego.kerberos.keytab']='/etc/security/keytabs/spnego.service.keytab'
 
     XmlConfig("ranger-admin-site.xml",
               conf_dir=ranger_conf,
